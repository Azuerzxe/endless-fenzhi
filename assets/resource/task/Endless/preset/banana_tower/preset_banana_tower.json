{
    "option": {
        "tower_banana_boss关是否切换喂豆间隔": {
            "type": "switch",
            "label": "boss关喂豆间隔",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "description": "关闭默认为4秒",
                    "pipeline_override": {
                        "tower_banana_boss_喂豆胆小姑2": {
                            "pre_delay": 4000
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "option": [
                        "tower_banana_boss关喂豆间隔"
                    ]
                }
            ]
        },
        "tower_banana_boss关喂豆间隔": {
            "type": "input",
            "label": "boss关喂豆间隔",
            "inputs": [
                {
                    "name": "喂豆间隔",
                    "label": "秒",
                    "verify": "^([1-9][0-9][0-9][0-9])$"
                }
            ],
            "pipeline_override": {
                "tower_banana_boss_喂豆胆小姑2": {
                    "pre_delay": "{喂豆间隔}000"
                }
            }
        },
        "tower_banana_小关是否切换喂豆间隔": {
            "type": "switch",
            "label": "小关喂豆间隔",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "description": "关闭默认为6秒",
                    "pipeline_override": {}
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "option": [
                        "tower_banana_小关喂豆间隔"
                    ]
                }
            ]
        },
        "tower_banana_小关喂豆间隔": {
            "type": "input",
            "label": "小关喂豆间隔",
            "inputs": [
                {
                    "name": "喂豆间隔",
                    "label": "喂豆间隔(单位毫秒)",
                    "verify": "^([1-9][0-9])$"
                }
            ],
            "pipeline_override": {
                "tower_banana_点波2": {
                    "repeat": "{喂豆间隔}"
                }
            }
        }
    }
}