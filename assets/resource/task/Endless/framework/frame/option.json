{
    "option": {
        "从boss关选卡界面开启": {
            "type": "switch",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "frame_wj_识别开始战斗": {
                            "next": [
                                "识别能量花位置",
                                "识别魔音位置",
                                "识别三叶草位置",
                                "frame_wj_boss_识别开始"
                            ]
                        },
                    }
                }
            ]
        },
        "fw_boss_是否开相机神器": {
            "type": "switch",
            "label": "boss关是否开相机神器复原植物",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "frame_wj_boss_过渡_相机神器1": {
                            "next": [
                                "frame_wj_boss_过渡"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "pipeline_override": {
                        "frame_wj_boss_过渡_相机神器1": {
                            "next": [
                                "frame_wj_boss_相机神器_复制1"
                            ]
                        },
                        "frame_wj_boss_喂豆5-3": {
                            "next": [
                                "frame_wj_boss_过渡_相机神器2",
                                "frame_wj_boss_喂豆5-3"
                            ]
                        },
                    }
                }
            ]
        },
        "fw_boss_补给智能选取": {
            "type": "switch",
            "label": "补给智能选取",
            "description": "优先级: 神器->全部植物->橙色植物->蓝色植物->紫色植物",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {}
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "pipeline_override": {
                        "frame_wj_识别boss关": {
                            "next": [
                                "frame_wj_神器补给_查看"
                            ]
                        }
                    }
                }
            ]
        },
        "fw_boss关是否需要喂豆": {
            "type": "switch",
            "label": "boss关是否需要喂豆",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "frame_wj_boss_过渡": {
                            "next": [
                                "frame_wj_boss_识别结算"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "option": [
                        "fw_boss关喂豆位置",
                        "fw_boss关喂豆间隔"
                    ]
                }
            ]
        },
        "fw_boss关是否加速": {
            "type": "switch",
            "label": "boss关是否加速",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "frame_wj_boss_判断是否进入关内": {
                            "action": "DoNothing",
                            "next": [
                                "frame_wj_boss_抛花1"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "pipeline_override": {
                        "frame_wj_boss_判断是否进入关内": {
                            "action": "click"
                        }
                    }
                }
            ]
        },
        "fw_boss关喂豆间隔": {
            "type": "input",
            "inputs": [
                {
                    "name": "秒",
                    "pipeline_type": "int",
                    "default": "4",
                    "verify": ""
                }
            ],
            "pipeline_override": {
                "frame_wj_boss_喂豆5-3": {
                    "post_delay": "{秒}000"
                },
            }
        },
        "fw_boss关喂豆位置": {
            "type": "input",
            "label": "喂豆位置",
            "description": "输入行列坐标，格式：列-行（例如 5-3）",
            "inputs": [
                {
                    "name": "列",
                    "pipeline_type": "string",
                    "default": "5",
                    "verify": "^[1-9]$",
                    "pattern_msg": "请输入1-9的数字"
                },
                {
                    "name": "行",
                    "pipeline_type": "string",
                    "default": "3",
                    "verify": "^[1-5]$",
                    "pattern_msg": "请输入1-5的数字"
                }
            ],
            "pipeline_override": {
                "frame_wj_boss_喂豆5-3": {
                    "end": "种植物_初始化_格子{列}_{行}",
                },
            }
        },
        "小关是否加速": {
            "type": "switch",
            "label": "小关是否加速",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "frame_wj_判断是否进入关内": {
                            "action": "DoNothing"
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "pipeline_override": {
                        "frame_wj_判断是否进入关内": {
                            "action": "click"
                        }
                    }
                }
            ]
        },
        "小关是否喂豆": {
            "type": "switch",
            "label": "小关是否喂豆",
            "description": "布好阵了在开,不然种不了植物.喂豆间隔不要太快了,不然容易没豆",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "frame_wj_点波2": {
                            "next": [
                                "frame_wj_识别结算",
                                "frame_wj_点波"
                            ]
                        },
                        "frame_wj_捡花1": {
                            "next": [
                                "frame_wj_点波"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "option": [
                        "是否开局喂豆球果",
                        "小关喂豆位置",
                        "小关喂豆间隔"
                    ]
                }
            ]
        },
        "是否开局喂豆球果": {
            "type": "switch",
            "label": "是否开局喂豆球果",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "喂豆球果"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "frame_wj_捡花1": {
                            "next": [
                                "frame_wj_点波"
                            ]
                        }
                    }
                }
            ]
        },
        "喂豆球果": {
            "type": "input",
            "label": "行列坐标",
            "inputs": [
                {
                    "name": "列",
                    "pipeline_type": "string",
                    "default": "1",
                    "verify": "^[1-9]$"
                },
                {
                    "name": "行",
                    "pipeline_type": "string",
                    "default": "1",
                    "verify": "^[1-5]$"
                }
            ],
            "pipeline_override": {
                "frame_wj_喂豆球果": {
                    "end": "种植物_初始化_格子{列}_{行}"
                }
            }
        },
        "小关喂豆位置": {
            "type": "input",
            "label": "喂豆位置",
