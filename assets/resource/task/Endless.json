        "多少秒后种魔甘": {
            "type": "input",
            "description": "左边旗子升起后，等待怪全部出完（然后种魔甘）的时间，毫秒为单位，默认15000毫秒",
            "inputs": [
                {
                    "name": "豪秒",
                    "pipeline_type": "int",
                    "default": "15000",
                    "verify": ""
                }
            ],
            "pipeline_override": {
                "魔甘收尾": {
                    "post_delay": "{豪秒}"
                }
            }
        },
        "使用三叶草": {
            "type": "switch",
            "description": "三叶草要在第七格，种植在9-5",
