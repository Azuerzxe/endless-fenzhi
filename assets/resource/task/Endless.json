        "小关是否抛花": {
            "type": "switch",
            "label": "普通关是否抛花",
            "description": "抛花位置为右上角(9-1)(9-2)",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "原大_判断是否进入关内": {
                            "next": [
                                "原大_点波1"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "pipeline_override": {
                        "原大_判断是否进入关内": {
                            "next": [
                                "原大_抛花1"
                            ]
                        }
                    }
                }
            ]
        },
        "boss关是否需要喂豆5-3": {
            "type": "switch",
            "label": "boss关是否需要喂豆",
            "description": "喂豆位置为5-3",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "原大_boss_判断是否进入关内": {
                            "next": [
                                "原大_boss_识别结算"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "pipeline_override": {
                        "原大_boss_判断是否进入关内": {
                            "next": [
                                "原大_boss_喂豆5-3"
                            ]
                        }
                    }
                }
            ]
        },
