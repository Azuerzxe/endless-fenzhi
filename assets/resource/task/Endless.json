        "是否魔甘收尾(牢玩家专属)": {
            "type": "switch",
            "label": "是否魔甘收尾(牢玩家专属)",
            "description": "魔音甜菜位于卡槽4,飓风甘兰位于卡槽5.甜薯位于卡槽6,魔音甜菜会种在9-3,飓风甘兰会种在7-2和7-4.甜薯种植在8-2和8-4",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {}
                },
                {
                    "name": "Yes",
                    "option": [
                        "多少秒后种魔甘",
                        "使用三叶草",
                        "魔甘高级选项"
                    ],
                    "label": "是",
                    "pipeline_override": {
                        "frame_wj_划飞弹": {
                            "next": [
                                "判断是否魔甘收尾"
                            ]
                        }
                    }
                }
            ]
        },
        "魔甘高级选项": {
            "type": "switch",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "option": [
                        "魔甘前使用能量豆",
                        "甜薯种植位置",
                        "飓风甘蓝种植位置",
                        "魔甘后是否重开"
                    ]
                }
            ]
        },
        "魔甘后是否重开": {
            "type": "switch",
            "description": "有气流水仙花可以关闭",
            "cases": [
                {
                    "name": "Yes"
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "无尽框架_结算超时_重开_暂停": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "甜薯种植位置": {
            "type": "select",
            "cases": [
                {
                    "name": "8-2,8-4"
