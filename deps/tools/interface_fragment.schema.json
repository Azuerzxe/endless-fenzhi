{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MaaFW Interface Fragment Schema",
    "description": "Schema for imported task/option/preset fragments, all fields optional.",
    "type": "object",
    "properties": {
        "task": {
            "type": "array",
            "items": {
                "$ref": "interface.schema.json#/definitions/taskItem"
            }
        },
        "option": {
            "type": "object",
            "additionalProperties": {
                "$ref": "interface.schema.json#/definitions/optionDefinition"
            }
        },
        "preset": {
            "type": "array",
            "items": {
                "$ref": "interface.schema.json#/properties/preset/items"
            }
        }
    },
    "additionalProperties": true
}